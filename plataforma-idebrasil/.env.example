# Ambiente da aplicação
NODE_ENV=development

# Porta do servidor backend
PORT=3001

# Configurações do banco de dados MySQL (para Docker)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_PASSWORD=idebrasil_pass123
DB_HOST=mysql
DB_PORT=3306
DB_NAME=idebrasil_db
DB_USER=idebrasil_user
DB_PASSWORD=idebrasil_pass123

# Chave secreta para JWT (ALTERE PARA UM VALOR SEGURO EM PRODUÇÃO)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Caminho para uploads
UPLOAD_PATH=/app/uploads
MAX_FILE_SIZE=5242880

# Configurações de CORS (origins permitidas)
CORS_ORIGIN=http://localhost:3000

# Configurações de rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Configurações de email (se implementar notificações)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# API externa IDEBRASIL (para validação de alunos)
IDEBRASIL_API_URL=https://api.idebrasil.com.br
IDEBRASIL_API_KEY=

# Configurações do frontend (para desenvolvimento local)
REACT_APP_API_URL=http://localhost/api
REACT_APP_VERSION=1.0.0
IDEBRASIL_API_KEY=